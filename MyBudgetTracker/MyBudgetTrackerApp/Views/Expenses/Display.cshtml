@model MyBudgetTrackerApp.Models.ExpenseCreateModel
@{
    ViewData["Title"] = "Display";
}

<span>Add Expense for : </span><span style="color: #007bff;">@Model.BankDetails.Month_Year</span>


@if (TempData["SuccessMessage"] != null)
{
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const modal = new bootstrap.Modal(document.getElementById('expenseModal'));
            modal.show();

            setTimeout(() => {
                modal.hide();
            }, 1500);
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const modal = new bootstrap.Modal(document.getElementById('errorModal'));
            modal.show();

            setTimeout(() => {
                modal.hide();
            }, 1500);
        });
    </script>
}

<!-- Success Modal -->
 <div class="modal fade" id="expenseModal" tabindex="-1" aria-labelledby="expenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-success">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="expenseModalLabel">Success</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-success fw-semibold">
                @TempData["SuccessMessage"]
            </div>

        </div>
    </div>
</div> 


<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-danger">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">Error</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-danger fw-semibold">
                @TempData["ErrorMessage"]
            </div>

        </div>
    </div>
</div>





<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddExpense">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="ExpenseSingle.Bank_ID" class="form-control" type="hidden" />

            <div class="form-row d-flex">
                <div class="form-group col-md-6 me-3">
                    <label asp-for="ExpenseSingle.ExpenseDetails" class="control-label"></label>
                    <input asp-for="ExpenseSingle.ExpenseDetails" class="form-control" />
                    <span asp-validation-for="ExpenseSingle.ExpenseDetails" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="ExpenseSingle.Amount" class="control-label"></label>
                    <input asp-for="ExpenseSingle.Amount" class="form-control" />
                    <span asp-validation-for="ExpenseSingle.Amount" class="text-danger"></span>
                </div>
            </div>

            <br />
            <div class="form-group">
                <input type="submit" action value="AddExpense" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<br />

@* Display list of bank balances *@
@{
    decimal totalAmount = 0;
}
@if (Model.ExpenseList != null)
{
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th scope="col">ExpenseDetails</th>
                <th scope="col">Amount</th>
                <th scope="col">Date</th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>

        @foreach (var _ExpenseList in Model.ExpenseList)
        {
            totalAmount += _ExpenseList.Amount; // Add amount here
            <form asp-action="Update" method="post">
                <input type="hidden" name="Id" value="@_ExpenseList.Id" />
                <input type="hidden" name="Bank_ID" value="@_ExpenseList.Bank_ID" />
            <tr>
                <td style="width: 250px;"><input type="text" name="ExpenseDetails" value="@_ExpenseList.ExpenseDetails" class="form-control" /></td>
                <td style="width: 250px;"><input type="text" name="Amount" value="@_ExpenseList.Amount" class="form-control amount" /></td>
                <td style="width: 140px;"><input type="text" readonly="readonly" name="Date" value="@_ExpenseList.Date" class="form-control" /></td>
                <td style="width: 80px;">
                    <button type="submit" name="actionType" value="Update" class="btn btn-primary">Update</button>
                </td>
                <td style="width: 80px;">
                    <button type="submit" name="actionType" value="Delete" class="btn btn-danger">Delete</button>
                </td>
            </tr>
            </form>
        }

        <tfoot>
            <tr>
                <td><strong>Main Bank Balance</strong></td>
                <td><strong class="text-success" id="BankBalance">@Model.BankDetails.Amount.ToString("N2")</strong></td>
                <td colspan="3"></td>
            </tr>

            <tr>
                <td><strong>Total Debit</strong></td>
                <td><strong class="text-danger" id="totaldebit">@totalAmount.ToString("N2")</strong></td>
                <td colspan="3"></td>
            </tr>
            <tr>
                <td><strong>Balance Amount</strong></td>
                <td><strong class="text-primary" id="totalAmount">@totalAmount.ToString("N2")</strong></td>
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>
}


@section Scripts {
    <script>
        function calculateTotal() {
            let total = 0;
            let BankBalance = 0;
            document.querySelectorAll('.amount').forEach(input => {
                let val = parseFloat(input.value);
                if (!isNaN(val)) {
                    total += val;
                }
            });

            // Fetch Value from BankBalance
            BankBalance = parseFloat(document.getElementById('BankBalance').textContent.replace(/,/g, ''));

            // Total Debit
             document.getElementById('totaldebit').textContent = total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Calculate the total amount
            document.getElementById('totalAmount').textContent = (BankBalance - total).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Initial calculation
        calculateTotal();

        // Listen to input changes
        document.querySelectorAll('.amount').forEach(input => {
            input.addEventListener('input', calculateTotal);
        });
    </script>
}

<h3>Expense Breakdown</h3>
<div style="max-width: 600px; height: 400px; margin: auto;">
    <canvas id="expenseChart"></canvas>
</div>

<script>
    const ctx = document.getElementById('expenseChart');

    const expenseChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ExpenseList.Select(e => e.ExpenseDetails))),
            datasets: [{
                label: 'Expenses by Category',
                data: @Html.Raw(Json.Serialize(Model.ExpenseList.Select(e => e.Amount))),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.7)',
                    'rgba(54, 162, 235, 0.7)',
                    'rgba(255, 206, 86, 0.7)',
                    'rgba(75, 192, 192, 0.7)'
                ],
                borderWidth: 1
            }]
        }
    });
</script>

